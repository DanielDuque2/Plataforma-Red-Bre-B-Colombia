<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Breb.App.ViewModels"
             x:DataType="vm:SaldoViewModel"
             x:Class="Breb.App.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,20"
            Spacing="18">

            <Label
                Text="Bre-B · Saldo de la cuenta"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"/>

            <Label Text="URL de la API (PC en la misma Wi-Fi)" FontSize="13"/>
            <Entry Text="{Binding UrlApi}"
                   Keyboard="Url"
                   Placeholder="http://192.168.1.25:5080"/>
            <Button Text="Guardar dirección de API"
                    Command="{Binding GuardarUrlApiCommand}"
                    HorizontalOptions="Fill"/>

            <Label Text="Usuario"
                    FontSize="13"/>
            <Entry Text="{Binding Usuario}"
                    Placeholder="usuario"/>

            <Label Text="Clave"
                    FontSize="13"/>
            <Entry Text="{Binding Clave}"
                    IsPassword="True"
                    Placeholder="clave"/>

            <Button
                Text="Consultar saldo"
                Command="{Binding ConsultarSaldoCommand}"
                HorizontalOptions="Fill"/>

            <ActivityIndicator IsRunning="{Binding Cargando}"
                    IsVisible="{Binding Cargando}"/>

            <BoxView HeightRequest="1"
                    BackgroundColor="LightGray"
                    Margin="0,10"/>

            <Label Text="Saldo disponible"
                    FontSize="13"
                    TextColor="Gray"/>
            <Label Text="{Binding SaldoTexto}"
                    FontSize="34"
                    FontAttributes="Bold"/>

            <Label Text="{Binding Estado}"
                    FontSize="13"
                    TextColor="Gray"
                    LineBreakMode="WordWrap"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
